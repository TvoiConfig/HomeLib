
&НаКлиенте
Процедура ЗначениеОтбораПриИзменении(Элемент) 
	
	Если ЗначениеЗаполнено(РеквизитОтбора) Тогда
		ОбновитьОтбор();
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура РеквезитОтбораПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		ОбновитьОтбор();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ОбновитьОтбор()     
	
	// Очистка текущего отбора
	Список.Отбор.Элементы.Очистить();     
	
	// Формирование нового отбора
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип ("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(РеквизитОтбора);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
	
КонецФункции

&НаКлиенте
Процедура СбросОтбора(Команда)
	Список.Отбор.Элементы.Очистить(); 
	
	ЗначениеОтбора = Неопределено;
	РеквизитОтбора = Неопределено;
КонецПроцедуры
