&НаКлиенте
Функция ОбновитьОтбор()     
	
	// Очистка текущего отбора
	Список.Отбор.Элементы.Очистить();     
	
	// Формирование нового отбора   
	Если ЗначениеЗаполнено(Автор) Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип ("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Автор");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Автор;  
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Жанр) Тогда                   
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип ("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Жанр");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
		ЭлементОтбора.ПравоеЗначение = Жанр;   
		
	КонецЕсли;  
	
КонецФункции

&НаКлиенте
Процедура СбросОтбора(Команда)
	Список.Отбор.Элементы.Очистить(); 
	
	Автор = Неопределено;
	Жанр = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура АвторПриИзменении(Элемент)
	ОбновитьОтбор();
КонецПроцедуры

&НаКлиенте
Процедура ЖанрПриИзменении(Элемент)
	ОбновитьОтбор();
КонецПроцедуры
