Процедура ОбработкаПроведения(Отказ, Режим) 
	// Чистка регистра при проведении
	Движения.ОстаткиКниг.Записывать = Истина;   
	Движения.ОстаткиКниг.Очистить();
	Движения.ОстаткиКниг.Записать();
	
	// Массив табличной части документа
	МассивКниг = Книги.ВыгрузитьКолонку("Книга"); 
	
	// Выдает книги которые не являются выданными другу
	Запрос = Новый Запрос;     
	Запрос.Текст = "ВЫБРАТЬ
	             |	Книги.Ссылка КАК Книга
	             |ИЗ
	             |	Справочник.Книги КАК Книги
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиКниг.Остатки КАК Ост
	             |		ПО (Ост.Книга = Книги.Ссылка)    
				 |
	             |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	             |			Ист.Книга КАК Книга,
	             |			МАКСИМУМ(Ист.ДатаВыдачи) КАК ДатаПоследнейВыдачи
	             |		ИЗ
	             |			РегистрСведений.ИсторияВыдачи КАК Ист
	             |		
	             |		СГРУППИРОВАТЬ ПО
	             |			Ист.Книга) КАК Последняя
	             |		ПО (Последняя.Книга = Книги.Ссылка) 
				 |
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияВыдачи КАК Ист
	             |		ПО (Ист.Книга = Последняя.Книга)
	             |			И (Ист.ДатаВыдачи = Последняя.ДатаПоследнейВыдачи)
	             |ГДЕ
	             |	Книги.Ссылка В(&МассивКниг)
	             |	И (Ост.КоличествоОстаток ЕСТЬ НЕ NULL 
	             |			ИЛИ Ист.Друг <> &Друг)";    
	Запрос.УстановитьПараметр("МассивКниг", МассивКниг);
	Запрос.УстановитьПараметр("Друг", Друг);
	РезультатЗапроса = Запрос.Выполнить();
	
	// Если все книги, введенные в табличную часть, выданы другу - выполняет цикл записи в регистр
	Если РезультатЗапроса.Пустой() Тогда     
		
		Для Каждого Книга из МассивКниг Цикл       
			// Регистр ОстаткиКниг Приход
			Движение = Движения.ОстаткиКниг.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Книга = Книга;
			Движение.Количество = 1; 
	  	КонецЦикла;      
	  
	Иначе    
		// Если не все книги, введенные в таб. часть, выданы другу тогда Отказ и сообщение пользователю какие именно
		Отказ = Истина;
		Выборка = РезультатЗапроса.Выбрать();
      	Сообщение = Новый СообщениеПользователю(); 
		
		// Цикл формирования Сообщения
		Пока Выборка.Следующий() Цикл
			Сообщение.Текст = Сообщение.Текст + Символы.ПС + "Книга " + Строка(Выборка.Книга) + " Не была выдана " + Строка(Друг) + "!";
		КонецЦикла;
		
		Сообщение.Сообщить(); 
		
    КонецЕсли;
	
	// Если все книги, введенные в табличную часть, выданы другу - выполняет запись регистра 
  	Если Не Отказ Тогда  
    
		Движения.ОстаткиКниг.Записывать = Истина;
		Движения.ОстаткиКниг.Записать();
   
   	КонецЕсли;
КонецПроцедуры


Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыдачаКниг") Тогда
		// Заполнение шапки
		Друг = ДанныеЗаполнения.Друг;
		Для Каждого ТекСтрокаКниги Из ДанныеЗаполнения.Книги Цикл
			НоваяСтрока = Книги.Добавить();
			НоваяСтрока.Книга = ТекСтрокаКниги.Книга;
		КонецЦикла;
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры
