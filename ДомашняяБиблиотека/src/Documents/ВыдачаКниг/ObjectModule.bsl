Процедура ОбработкаПроведения(Отказ, Режим)    
	
	Движения.ОстаткиКниг.Записывать = Истина;  
	Движения.ИсторияВыдачи.Записывать = Истина;
	
	Для Каждого ТекСтрокаКниги Из Книги Цикл 		
		
		// Регистр ОстаткиКниг Расход
		Движение = Движения.ОстаткиКниг.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Книга = ТекСтрокаКниги.Книга;
		Движение.Количество = 1;            
		
		// Регистр ИсторияВыдачи
		Движение = Движения.ИсторияВыдачи.Добавить();
		Движение.Книга = ТекСтрокаКниги.Книга;
		Движение.Друг = Друг;
		Движение.ДатаВыдачи = Дата;
		Движение.СрокВозврата = ТекСтрокаКниги.СрокВозврата;
		
	КонецЦикла;  
	
	Движения.Записать();
	
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		Запрос = Новый Запрос;    
		Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиКнигОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ОстаткиКнигОстатки.Книга КАК Книга
	               |ИЗ
	               |	РегистрНакопления.ОстаткиКниг.Остатки КАК ОстаткиКнигОстатки
	               |ГДЕ
	               |	ОстаткиКнигОстатки.КоличествоОстаток < 0";
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДеталейЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДеталейЗаписи.Следующий() Цикл
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не хватает " + Строка(ВыборкаДеталейЗаписи.Книга);
			Сообщение.Сообщить();
			
			Отказ = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры